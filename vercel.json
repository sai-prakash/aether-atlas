{
  "framework": "tanstack-start",
  "functions": {
    "src/routes/api/cron.ts": { "maxDuration": 60 },
    "src/routes/api/publish.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/publish",
      "schedule": "30 2 * * 5"
    }
  ]
}
